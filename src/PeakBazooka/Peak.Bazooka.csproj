<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<AssemblyName>PeakBazooka</AssemblyName>
		<AssemblyTitle>PeakBazooka</AssemblyTitle>
		<Authors>Arman Ossi Loko</Authors>
		<Company>Arman Ossi Loko</Company>
		<Copyright>Copyright (c) 2026 Fake Game Developers</Copyright>
		<Description>A bazooka built from PEAK's AntiZooka that fires exploding rockets instead of antigravity bubbles.</Description>
		<Version>1.0.0</Version>
		<RootNamespace>Peak.Bazooka</RootNamespace>
		<ThunderstorePackable>true</ThunderstorePackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="PEAKModding.PEAKLib.Core" Version="1.7.2" />
		<PackageReference Include="PEAKModding.PEAKLib.Items" Version="1.6.2" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="icons\BazookaIcon.png">
			<LogicalName>Peak.Bazooka.icons.BazookaIcon.png</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="localization\strings.csv">
			<LogicalName>Peak.Bazooka.localization.strings.csv</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

</Project>
